import PMAction.NativeRootGenerators
import PMAction.FiniteMatrixTransport

/-! Coherent transport generated by native root-response cost operators.
Smooth real control one-forms weight the certified roots. The full eight-label
carrier generator and its four-coordinate packet generator are derived together;
the resulting links are not arbitrary matrices supplied at the packet level.
The controls and admission of the existing coherent amplitude dynamics remain
physical inputs. No claim of unique selection or a separate internal gauge factor
inside the full vacuum spinor is made. -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
namespace PMAction.NativeCoherentLinks
open Matrix CarrierEvents CarrierParity NativeRootGenerators Filter Topology
open scoped Matrix.Norms.L2Operator
abbrev V := Fin 4 → ℝ
abbrev Controls := Fin 4 → V → V →L[ℝ] ℝ

def form {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    (B : Fin 4 → F) (w : Controls) (x : V) : V →L[ℝ] F := ∑ j,(w j x).smulRight (B j)

lemma form_c2 {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    (B : Fin 4 → F) (w : Controls) (hw : ∀ j, ContDiff ℝ 2 (w j)) : ContDiff ℝ 2 (form B w) := by
  have hs (j : Fin 4) : ContDiff ℝ 2 (fun x => (w j x).smulRight (B j)) := by
    exact ((ContinuousLinearMap.smulRightL ℝ V F).flip (B j)).contDiff.comp (hw j)
  unfold form
  fun_prop

def nativeRoot (c : Fin 3) (j : Fin 4) := (-Complex.I) • cost c j
def packetRoot (c : Fin 3) (j : Fin 4) := (-Complex.I) • packetCost c j

def nativeA (c : Fin 3) (w : Controls) : V → V →L[ℝ] Matrix (Carrier c) (Carrier c) ℂ :=
  form (nativeRoot c) w
def packetA (c : Fin 3) (w : Controls) : V → V →L[ℝ] Matrix (Fin 4) (Fin 4) ℂ :=
  form (packetRoot c) w

lemma nativeRoot_skew (c : Fin 3) (j : Fin 4) : star (nativeRoot c j)=-nativeRoot c j := by
  change (nativeRoot c j)ᴴ=-nativeRoot c j
  simp [nativeRoot,conjTranspose_smul,(cost_hermitian c j).eq]
lemma packetRoot_skew (c : Fin 3) (j : Fin 4) : star (packetRoot c j)=-packetRoot c j := by
  change (packetRoot c j)ᴴ=-packetRoot c j
  simp [packetRoot,conjTranspose_smul,(packetCost_hermitian c j).eq]

lemma native_skew (c : Fin 3) (w : Controls) (x v : V) : star (nativeA c w x v)=-nativeA c w x v := by
  simp [nativeA,form,ContinuousLinearMap.smulRight_apply,star_sum,star_smul,nativeRoot_skew,
    ← Finset.sum_neg_distrib]
lemma packet_skew (c : Fin 3) (w : Controls) (x v : V) : star (packetA c w x v)=-packetA c w x v := by
  simp [packetA,form,ContinuousLinearMap.smulRight_apply,star_sum,star_smul,packetRoot_skew,
    ← Finset.sum_neg_distrib]

lemma root_observed (c : Fin 3) (j : Fin 4) :
    NativeObservation.Obs (embedding c) (nativeRoot c j) (packetRoot c j) :=
  NativeObservation.smul (-Complex.I) (cost_observed c j)

lemma generator_observed (c : Fin 3) (w : Controls) (x v : V) :
    NativeObservation.Obs (embedding c) (nativeA c w x v) (packetA c w x v) := by
  constructor
  · simp only [nativeA,packetA,form,_root_.sum_apply,ContinuousLinearMap.smulRight_apply,
      Matrix.sum_mul,Matrix.mul_sum,Matrix.smul_mul,Matrix.mul_smul]
    exact Finset.sum_congr rfl fun j _ => congrArg ((w j x v) • ·) (root_observed c j).1
  · simp only [nativeA,packetA,form,_root_.sum_apply,ContinuousLinearMap.smulRight_apply,
      Matrix.sum_mul,Matrix.mul_sum,Matrix.smul_mul,Matrix.mul_smul]
    exact Finset.sum_congr rfl fun j _ => congrArg ((w j x v) • ·) (root_observed c j).2

/-- One full native-label transport and its exact packet readout. -/
structure Realization (c : Fin 3) (w : Controls) where
  native : V → V → ℝ → Matrix (Carrier c) (Carrier c) ℂ
  packet : V → V → ℝ → Matrix (Fin 4) (Fin 4) ℂ
  native_zero : ∀ y v, native y v 0=1
  packet_zero : ∀ y v, packet y v 0=1
  native_deriv : ∀ y v s, HasDerivAt (native y v) (native y v s*nativeA c w (y+s • v) v) s
  packet_deriv : ∀ y v s, HasDerivAt (packet y v) (packet y v s*packetA c w (y+s • v) v) s
  native_unitary : ∀ y v s, native y v s ∈ unitary _
  packet_unitary : ∀ y v s, packet y v s ∈ unitary _
  intertwines : ∀ y v s, native y v s*embedding c=embedding c*packet y v s
  observes : ∀ y v s, (embedding c)ᴴ*native y v s=packet y v s*(embedding c)ᴴ

/-- Native coherent links exist for C² control one-forms; all carrier modes are
included, and the packet generator is fixed by the native root response. -/
theorem realization_exists (c : Fin 3) (w : Controls) (hw : ∀ j, ContDiff ℝ 2 (w j)) :
    Nonempty (Realization c w) := by
  have hn : Continuous (nativeA c w) := (form_c2 _ w hw).continuous
  have hp : Continuous (packetA c w) := (form_c2 _ w hw).continuous
  have hex (y v : V) := FiniteMatrixTransport.exists_transport (fun s : ℝ => nativeA c w (y+s • v) v)
    (by fun_prop) (fun s => native_skew c w (y+s • v) v)
  choose T hT0 hTd hTu using hex
  obtain ⟨U,hU0,hUd,hUu⟩ := TransportExistence.exists_connection_transport (packetA c w) hp (packet_skew c w)
  have hi (y v : V) (s : ℝ) : T y v s*embedding c=embedding c*U y v s :=
    FiniteMatrixTransport.intertwining (embedding c)
      (fun t => (generator_observed c w (y+t • v) v).1) (fun t => packet_skew c w (y+t • v) v)
      (T y v) (U y v) (hT0 y v) (hU0 y v) (hTd y v) (hUd y v) (hUu y v) s
  exact ⟨⟨T,U,hT0,hU0,hTd,hUd,hTu,hUu,hi,
    fun y v s => FiniteMatrixTransport.readout (embedding c) _ _ (hi y v s) (hTu y v s) (hUu y v s)⟩⟩

def realized (c : Fin 3) (w : Controls) (hw : ∀ j, ContDiff ℝ 2 (w j)) : Realization c w :=
  Classical.choice (realization_exists c w hw)

/-- The links read from the native coherent dynamics have the classical D4
Yang–Mills site-action limit. Smooth controls are inputs, not fitted constants. -/
theorem native_yang_mills (c : Fin 3) (w : Controls) (hw : ∀ j, ContDiff ℝ 2 (w j))
    {S : Set V} (hSb : Bornology.IsBounded S) (hSm : MeasurableSet S)
    (hSf : MeasureTheory.volume (frontier S)=0) (β : ℝ) :
    Tendsto (fun n => LatticeSiteAction.siteAction (realized c w hw).packet β S n) atTop
      (𝓝 (∫ y in S, UniformGaugeAction.yangMillsDensity (packetA c w) (fderiv ℝ (packetA c w)) y β)) :=
  ConnectionRegularity.d4_yang_mills_action_c2 hSb hSm hSf (form_c2 _ w hw) (packet_skew c w)
    (realized c w hw).packet (realized c w hw).packet_zero (realized c w hw).packet_deriv β

theorem reciprocal (c : Fin 3) (w : Controls) (r : Realization c w) (y v : V) (h : ℝ) :
    r.packet (y+h • v) (-v) h=star (r.packet y v h) :=
  TransportExistence.connection_reciprocal (packet_skew c w) r.packet r.packet_zero
    r.packet_deriv r.packet_unitary y v h

/-- Noncommuting native root costs yield a nonzero commutator field-strength
component; this is not merely a pure-gauge relabeling construction. -/
theorem nonzero_root_curvature (c : Fin 3) :
    (packetRoot c 0*packetRoot c 1-packetRoot c 1*packetRoot c 0) 0 2=-1 := by
  have hI : (-Complex.I) * (-Complex.I) = -1 := by rw [neg_mul_neg, Complex.I_mul_I]
  have e : packetRoot c 0*packetRoot c 1-packetRoot c 1*packetRoot c 0 =
      -(packetCost c 0*packetCost c 1-packetCost c 1*packetCost c 0) := by
    simp only [packetRoot, smul_mul_smul_comm, hI, neg_one_smul]
    abel
  rw [e, Matrix.neg_apply, noncommuting_costs]

end PMAction.NativeCoherentLinks
