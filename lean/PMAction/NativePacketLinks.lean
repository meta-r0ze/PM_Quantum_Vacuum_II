import PMAction.StateIdentification
import PMAction.SubstrateWeylRoots
import PMAction.GaugeRecordLinks
import Mathlib.GroupTheory.Subgroup.Centralizer
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Topology.Separation.Connected

/-! Native packet links extracted from actual D4 carrier root words, already
certified as restrictions of E8 reflections. The packet is the intrinsic
four-coordinate odd sector of the existing eight labels; no new payload index
or arbitrary unitary link is introduced. This identifies a transport subsystem,
not an independent gauge factor of the full vacuum spinor update. -/
noncomputable section
set_option backward.isDefEq.respectTransparency false
namespace PMAction.NativePacketLinks
open Matrix CarrierEvents CarrierParity

lemma simple_parity : ∀ (c : Fin 3) (j : Fin 4) (v : Carrier c),
    CarrierWeyl.simple c j (antipode c v)=antipode c (CarrierWeyl.simple c j v) := by decide +kernel

/-- Exactly the subgroup generated by the certified native simple roots. -/
def rootGroup (c : Fin 3) : Subgroup (Equiv.Perm (Carrier c)) :=
  Subgroup.closure (Set.range (CarrierWeyl.simple c))
abbrev Action (c : Fin 3) : Type := rootGroup c

def root (c : Fin 3) (j : Fin 4) : Action c :=
  ⟨CarrierWeyl.simple c j,Subgroup.subset_closure ⟨j,rfl⟩⟩

lemma parity (c : Fin 3) (p : Action c) (v : Carrier c) :
    (p : Equiv.Perm (Carrier c)) (antipode c v)=antipode c ((p : Equiv.Perm (Carrier c)) v) := by
  have hle : rootGroup c ≤ Subgroup.centralizer {antipode c} := by
    change Subgroup.closure _ ≤ _
    rw [Subgroup.closure_le]
    rintro _ ⟨j,rfl⟩
    apply Subgroup.mem_centralizer_singleton_iff.mpr
    exact Equiv.ext (simple_parity c j)
  exact congrFun (congrArg Equiv.toFun (Subgroup.mem_centralizer_singleton_iff.mp (hle p.2))) v

/-- Forward label action; the inverse row lookup fixes the product convention. -/
def physical (c : Fin 3) (p : Action c) : Matrix (Carrier c) (Carrier c) ℂ :=
  ((p : Equiv.Perm (Carrier c))⁻¹).permMatrix ℂ

def link (c : Fin 3) (p : Action c) : Matrix (Fin 4) (Fin 4) ℂ :=
  (embedding c)ᴴ * physical c p * embedding c

lemma physical_one (c : Fin 3) : physical c 1=1 := by simp [physical]
lemma physical_mul (c : Fin 3) (p q : Action c) : physical c (p*q)=physical c p*physical c q := by
  simp [physical]
lemma physical_star (c : Fin 3) (p : Action c) : physical c p⁻¹=(physical c p)ᴴ := by
  simp [physical,conjTranspose_permMatrix]
lemma physical_unitary (c : Fin 3) (p : Action c) : physical c p ∈ unitary _ := by
  constructor
  · change (physical c p)ᴴ*physical c p=1
    rw [← physical_star,← physical_mul,inv_mul_cancel,physical_one]
  · change physical c p*(physical c p)ᴴ=1
    rw [← physical_star,← physical_mul,mul_inv_cancel,physical_one]

lemma observed (c : Fin 3) (p : Action c) :
    NativeObservation.Obs (embedding c) (physical c p) (link c p) := by
  have hp : physical c p*(antipode c).permMatrix ℂ=
      (antipode c).permMatrix ℂ*physical c p := by
    unfold physical
    rw [← permMatrix_mul,← permMatrix_mul]
    congr 1
    exact Equiv.ext fun v => (parity c p⁻¹ v).symm
  have hc : physical c p*(embedding c*(embedding c)ᴴ)=
      (embedding c*(embedding c)ᴴ)*physical c p := by
    rw [projector]
    simp only [Matrix.mul_smul,Matrix.smul_mul,Matrix.mul_sub,Matrix.sub_mul,
      Matrix.mul_one,Matrix.one_mul,hp]
  have hi : physical c p*embedding c=embedding c*link c p := by
    change physical c p*embedding c=embedding c*((embedding c)ᴴ*physical c p*embedding c)
    calc physical c p*embedding c = physical c p*(embedding c*(embedding c)ᴴ)*embedding c := by
          simp only [Matrix.mul_assoc,isometry,Matrix.mul_one]
         _ = _ := by rw [hc]; simp only [Matrix.mul_assoc]
  exact NativeObservation.of_commute (isometry c) hi hc

lemma link_one (c : Fin 3) : link c 1=1 := by simp [link,physical_one,isometry]
lemma link_mul (c : Fin 3) (p q : Action c) : link c (p*q)=link c p*link c q := by
  calc link c (p*q) = (embedding c)ᴴ*(physical c p*physical c q)*embedding c := by
        simp only [link,physical_mul]
       _ = (embedding c)ᴴ*physical c p*(physical c q*embedding c) := by simp only [Matrix.mul_assoc]
       _ = (embedding c)ᴴ*physical c p*(embedding c*link c q) := by rw [(observed c q).1]
       _ = ((embedding c)ᴴ*physical c p*embedding c)*link c q := by simp only [Matrix.mul_assoc]
       _ = link c p*link c q := rfl

lemma link_star (c : Fin 3) (p : Action c) : link c p⁻¹=(link c p)ᴴ := by
  simp only [link,physical_star,conjTranspose_mul,conjTranspose_conjTranspose,Matrix.mul_assoc]

/-- A unitary packet link follows from the native label update and parity, not a
supplied packet matrix or an added payload space. -/
theorem link_unitary (c : Fin 3) (p : Action c) : link c p ∈ unitary _ := by
  constructor
  · change (link c p)ᴴ*link c p=1
    rw [← link_star,← link_mul,inv_mul_cancel,link_one]
  · change link c p*(link c p)ᴴ=1
    rw [← link_star,← link_mul,mul_inv_cancel,link_one]

/-- Exact packet evolution and all-state readout, with no invisible feedback. -/
theorem packet_step (c : Fin 3) (p : Action c) (ψ : Fin 4 → ℂ) :
    physical c p *ᵥ (embedding c *ᵥ ψ)=embedding c *ᵥ (link c p *ᵥ ψ) := by
  rw [mulVec_mulVec,(observed c p).1,← mulVec_mulVec]
theorem readout_step (c : Fin 3) (p : Action c) (ψ : Carrier c → ℂ) :
    (embedding c)ᴴ *ᵥ (physical c p *ᵥ ψ)=link c p *ᵥ ((embedding c)ᴴ *ᵥ ψ) := by
  rw [mulVec_mulVec,(observed c p).2,← mulVec_mulVec]

/-- Word subdivision is exact on actual labels and on their extracted links. -/
theorem word_subdivision (c : Fin 3) (w z : List (Fin 4)) :
    link c (((w++z).map (root c)).prod)=
      link c ((w.map (root c)).prod)*link c ((z.map (root c)).prod) := by
  rw [List.map_append,List.prod_append,link_mul]

/-- There are only finitely many packet links from pure native permutations,
regardless of the length of the root word. -/
theorem finite_links (c : Fin 3) : (Set.range (link c)).Finite := Set.finite_range _

/-- A continuous fixed-packet family of pure root-word links is constant.
Continuous coherent evolution therefore needs more than choosing longer words
on these same labels. This does not rule out growing-system continuum limits. -/
theorem continuous_native_constant (c : Fin 3) (U : ℝ → Matrix (Fin 4) (Fin 4) ℂ)
    (hU : Continuous U) (hnative : ∀ t, U t ∈ Set.range (link c)) (s t : ℝ) : U s=U t := by
  have hf : (Set.range U).Finite := (finite_links c).subset (by rintro _ ⟨t,rfl⟩; exact hnative t)
  have hc : IsPreconnected (Set.range U) := by
    simpa only [Set.image_univ] using isPreconnected_univ.image U hU.continuousOn
  by_contra hne
  exact (hc.infinite_of_nontrivial ⟨U s,⟨s,rfl⟩,U t,⟨t,rfl⟩,hne⟩) hf

end PMAction.NativePacketLinks
