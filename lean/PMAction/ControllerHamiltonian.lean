import PMAction.CoherentComparisonRepair
import PMAction.LinkEvolution

/-! The explicit Hamiltonian of the existing coherent comparison controller.
This is an operator identity, not a proof that the extended generator and flag
space are selected/admissible substrate resources or have a particular toll. -/
noncomputable section
namespace PMAction.ControllerHamiltonian
open Matrix Finset PMAction CoherentComparisonRepair
variable {n : Type*} [Fintype n] [DecidableEq n]
local notation "M" => Matrix n n ℂ
local notation "CM" => Matrix (n ⊕ n) (n ⊕ n) ℂ

def lift (H : M) : CM := fromBlocks ((1/2 : ℂ) • H) ((-1/2 : ℂ) • H)
  ((-1/2 : ℂ) • H) ((1/2 : ℂ) • H)

/-- Unnormalized branch change. Its inverse is half itself; it is used only
as an algebraic change of coordinates, not counted as a primitive gate. -/
def branchChange : CM := fromBlocks 1 1 1 (-1)
def branchInverse : CM := (1/2 : ℂ) • branchChange

lemma branch_inverse_left : branchInverse (n := n)*branchChange=1 := by
  rw [branchInverse,smul_mul_assoc,branchChange,fromBlocks_multiply,fromBlocks_smul]
  rw [← fromBlocks_one,fromBlocks_inj]
  simp only [mul_one,mul_neg,neg_neg]
  refine ⟨?_,?_,?_,?_⟩ <;> module

lemma branch_inverse_right : branchChange (n := n)*branchInverse=1 := by
  simp only [branchInverse,mul_smul_comm]
  simpa only [branchInverse,smul_mul_assoc] using (branch_inverse_left (n := n))

def branchUnits : CMˣ where
  val := branchChange
  inv := branchInverse
  val_inv := branch_inverse_right
  inv_val := branch_inverse_left

lemma lift_conjugate (H : M) :
    lift H=branchChange*fromBlocks 0 0 0 H*branchInverse := by
  simp only [branchChange,branchInverse,fromBlocks_multiply,Matrix.mul_smul,
    fromBlocks_smul,zero_mul,mul_zero,one_mul,mul_one,neg_mul,mul_neg,
    zero_add,add_zero,smul_neg]
  rw [lift,fromBlocks_inj]
  refine ⟨?_,?_,?_,?_⟩ <;> module

lemma compare_conjugate (U : M) :
    compare U=branchChange*fromBlocks 1 0 0 U*branchInverse := by
  simp only [branchChange,branchInverse,fromBlocks_multiply,Matrix.mul_smul,
    fromBlocks_smul,mul_zero,one_mul,mul_one,neg_mul,mul_neg,
    zero_add,add_zero,smul_neg,CoherentComparisonRepair.compare,plus,minus]
  rw [fromBlocks_inj]
  refine ⟨?_,?_,?_,?_⟩ <;> module

/-- A continuous block-diagonal ring homomorphism, used only to transport
matrix exponential. It supplies no physical composition or locality premise. -/
def blockHom : (M × M) →+* CM where
  toFun p := fromBlocks p.1 0 0 p.2
  map_one' := fromBlocks_one
  map_zero' := by ext i j; cases i <;> cases j <;> rfl
  map_add' p q := by ext i j; cases i <;> cases j <;> simp
  map_mul' p q := by simp [fromBlocks_multiply]

lemma blockHom_continuous : Continuous (blockHom (n := n)) := by
  apply continuous_matrix
  intro i j
  cases i <;> cases j
  · exact continuous_fst.matrix_elem _ _
  · exact continuous_const
  · exact continuous_const
  · exact continuous_snd.matrix_elem _ _

open scoped Matrix.Norms.Operator in
lemma exp_block (A B : M) :
    NormedSpace.exp (fromBlocks A 0 0 B)=fromBlocks (NormedSpace.exp A) 0 0 (NormedSpace.exp B) := by
  have he := NormedSpace.map_exp (blockHom (n := n)) blockHom_continuous (A,B)
  change fromBlocks (NormedSpace.exp (A,B)).1 0 0 (NormedSpace.exp (A,B)).2=
    NormedSpace.exp (fromBlocks A 0 0 B) at he
  have hf : (NormedSpace.exp (A,B)).1=NormedSpace.exp A :=
    NormedSpace.map_exp (RingHom.fst M M) continuous_fst (A,B)
  have hg : (NormedSpace.exp (A,B)).2=NormedSpace.exp B :=
    NormedSpace.map_exp (RingHom.snd M M) continuous_snd (A,B)
  rw [hf,hg] at he
  exact he.symm

omit [Fintype n] [DecidableEq n] in
lemma lift_smul (z : ℂ) (H : M) : lift (z • H)=z • lift H := by
  simp [lift,fromBlocks_smul,smul_smul,mul_comm]

open scoped Matrix.Norms.Operator in
/-- Exact controller exponential for any complex parameter. This includes
both phase evolution and the formal Euclidean transfer identity. -/
theorem exponential_smul (H : M) (z : ℂ) :
    NormedSpace.exp (z • lift H)=compare (NormedSpace.exp (z • H)) := by
  rw [← lift_smul,lift_conjugate]
  have he := Matrix.exp_units_conj (branchUnits (n := n)) (fromBlocks 0 0 0 (z • H))
  change NormedSpace.exp (branchChange*fromBlocks 0 0 0 (z • H)*branchInverse)=
    branchChange*NormedSpace.exp (fromBlocks 0 0 0 (z • H))*branchInverse at he
  rw [he,exp_block,NormedSpace.exp_zero]
  exact (compare_conjugate _).symm

open scoped Matrix.Norms.Operator in
/-- The existing comparison is generated by this one explicit lift of H. -/
theorem exponential (H : M) (t : ℝ) :
    NormedSpace.exp (((t : ℂ)*Complex.I) • lift H)=
      compare (NormedSpace.exp (((t : ℂ)*Complex.I) • H)) :=
  exponential_smul H _

omit [Fintype n] [DecidableEq n] in
lemma lift_hermitian (H : M) (hH : H.IsHermitian) : (lift H).IsHermitian := by
  change (lift H)ᴴ=lift H
  simp [lift,fromBlocks_conjTranspose,conjTranspose_smul,hH.eq]

/-- The squared lifted generator is the lift of H². -/
lemma lift_mul (H J : M) : lift H*lift J=lift (H*J) := by
  simp only [lift,fromBlocks_multiply,smul_mul_smul_comm]
  congr 1 <;> module

/-- Controller trace stiffness retains every relative carrier index; no
sector-dependent correction is generated by this universal lift. -/
theorem trace_square (H : M) : (lift H*lift H).trace=(H*H).trace := by
  rw [lift_mul]
  simp [lift,Matrix.trace,Matrix.diag,Fintype.sum_sum_type,← mul_sum]
  ring

omit [DecidableEq n] in
lemma nsq_sum (φ χ : n → ℂ) :
    CommonResponse.nsq (Sum.elim φ χ)=CommonResponse.nsq φ+CommonResponse.nsq χ := by
  simp [PMAction.LinkExpansion.nsq_eq,Fintype.sum_sum_type]

omit [DecidableEq n] in
lemma nsq_smul (z : ℂ) (φ : n → ℂ) :
    CommonResponse.nsq (z • φ)=Complex.normSq z*CommonResponse.nsq φ := by
  simp [PMAction.LinkExpansion.nsq_eq,Complex.normSq_mul,mul_sum]

omit [DecidableEq n] in
lemma prepared_generator_action (H : M) (φ : n → ℂ) :
    lift H*ᵥ Sum.elim φ (fun _ => 0)=
      Sum.elim ((1/2 : ℂ) • (H*ᵥ φ)) ((-1/2 : ℂ) • (H*ᵥ φ)) := by
  have hz (J : M) : J*ᵥ (fun _ : n => (0 : ℂ))=0 := Matrix.mulVec_zero J
  rw [lift,fromBlocks_mulVec]
  simp only [Function.comp_def,Sum.elim_inl,Sum.elim_inr,hz,add_zero,smul_mulVec]

omit [DecidableEq n] in
theorem prepared_generator_norm (H : M) (φ : n → ℂ) :
    CommonResponse.nsq (lift H*ᵥ Sum.elim φ (fun _ => 0))=
      (1/2)*CommonResponse.nsq (H*ᵥ φ) := by
  rw [prepared_generator_action,nsq_sum,nsq_smul,nsq_smul]
  norm_num [Complex.normSq_apply]
  ring

lemma comparison_prepared_action (U : M) (φ : n → ℂ) :
    compare U*ᵥ Sum.elim φ (fun _ => 0)=
      Sum.elim (plus U*ᵥ φ) (minus U*ᵥ φ) := by
  have hz (J : M) : J*ᵥ (fun _ : n => (0 : ℂ))=0 := Matrix.mulVec_zero J
  rw [CoherentComparisonRepair.compare,fromBlocks_mulVec]
  simp only [Function.comp_def,Sum.elim_inl,Sum.elim_inr,hz,add_zero]

lemma prepared_displacement (U : M) (φ : n → ℂ) :
    Sum.elim φ (fun _ => 0)-compare U*ᵥ Sum.elim φ (fun _ => 0)=
      Sum.elim ((1/2 : ℂ) • (φ-U*ᵥ φ)) ((-1/2 : ℂ) • (φ-U*ᵥ φ)) := by
  rw [comparison_prepared_action]
  ext i
  cases i <;> simp [plus,minus,add_mulVec,sub_mulVec,one_mulVec,smul_mulVec] <;> ring

/-- Exact comparison-change metric on the prepared controller. This is not
an identification of that metric with required primitive event count. -/
theorem prepared_change_norm (U : M) (φ : n → ℂ) :
    CommonResponse.nsq (Sum.elim φ (fun _ => 0)-compare U*ᵥ Sum.elim φ (fun _ => 0))=
      (1/2)*CommonResponse.nsq (φ-U*ᵥ φ) := by
  rw [prepared_displacement,nsq_sum,nsq_smul,nsq_smul]
  norm_num [Complex.normSq_apply]
  ring

/-- Applying the common state-change readout to the whole controller gives
half the original carrier readout. It is a different observable from the
controller's own minus-port flag. The factor is universal across sectors. -/
theorem controller_state_flag (U : M) (φ : n → ℂ) :
    CommonResponse.stateFlag (compare U) (Sum.elim φ (fun _ => 0))=
      (1/2)*CommonResponse.stateFlag U φ := by
  unfold CommonResponse.stateFlag
  rw [prepared_change_norm]
  ring

/-- Conditional common-pricing consequence, not a primitive-cost derivation.
A common scalar factor can be calibrated, but cannot alter relative indices. -/
theorem common_pricing_factor (U : M) (φ : n → ℂ) (toll : ℝ) (m : ℕ) :
    CommonResponse.responseCost toll m
      (CommonResponse.stateFlag (compare U) (Sum.elim φ (fun _ => 0)))=
      (1/2)*CommonResponse.responseCost toll m (CommonResponse.stateFlag U φ) := by
  rw [controller_state_flag]
  unfold CommonResponse.responseCost
  ring

end PMAction.ControllerHamiltonian
