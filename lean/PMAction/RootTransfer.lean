import PMAction.Reconstruction
import PMAction.SelectedSampling
import PMAction.CarrierResponse

/-!
# A lazy survival transfer generated by the actual root involution

With supplied attempt probability p, stay with probability 1-p and apply
the specified involution with probability p. For 0<p<1/2 the transfer is
nonnegative, stochastic, symmetric and injective, with positive two-tick
transfer. Its sampling rate is not selected by a stationary uniform law.
-/
noncomputable section
namespace PMAction.RootTransfer
open Matrix
variable {n : Type*} [Fintype n] [DecidableEq n]

def transfer (e : Equiv.Perm n) (p : ℝ) : Matrix n n ℝ :=
  (1-p) • 1 + p • e.permMatrix ℝ

omit [Fintype n] [DecidableEq n] in
lemma inverse_self (e : Equiv.Perm n) (he : Function.Involutive e) : e⁻¹ = e := by
  have hsq : e * e = 1 := by ext x; exact he x
  calc
    e⁻¹ = e⁻¹ * (e*e) := by rw [hsq, mul_one]
    _ = e := by rw [← mul_assoc, inv_mul_cancel, one_mul]

lemma permutation_square (e : Equiv.Perm n) (he : Function.Involutive e) :
    e.permMatrix ℝ * e.permMatrix ℝ = 1 := by
  have hsq : e * e = 1 := by ext x; exact he x
  rw [← permMatrix_mul, hsq, permMatrix_one]

omit [Fintype n] in
/-- The transfer rate is specified, not inferred from a stationary probability law. -/
theorem nonnegative (e : Equiv.Perm n) (p : ℝ) (hp : 0 ≤ p) (hp1 : p ≤ 1) :
    ∀ i j, 0 ≤ transfer e p i j := by
  intro i j
  simp only [transfer, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
  apply add_nonneg
  · exact mul_nonneg (by linarith) (by simp [Matrix.one_apply]; split_ifs <;> norm_num)
  · apply mul_nonneg hp
    simp [Equiv.Perm.permMatrix, PEquiv.toMatrix_apply]
    split_ifs <;> norm_num

lemma preserves_ones (e : Equiv.Perm n) (p : ℝ) :
    transfer e p *ᵥ (fun _ => 1) = fun _ => 1 := by
  rw [transfer, add_mulVec, smul_mulVec, smul_mulVec, one_mulVec, permMatrix_mulVec]
  ext i
  simp [Function.comp_def]

theorem stochastic (e : Equiv.Perm n) (p : ℝ) (i : n) : ∑ j, transfer e p i j = 1 := by
  simpa [mulVec, dotProduct] using congrFun (preserves_ones e p) i

omit [Fintype n] in
theorem symmetric (e : Equiv.Perm n) (he : Function.Involutive e) (p : ℝ) :
    (transfer e p).IsSymm := by
  change (transfer e p)ᵀ = transfer e p
  simp [transfer, transpose_permMatrix, inverse_self e he]

lemma inverse_numerator (e : Equiv.Perm n) (he : Function.Involutive e) (p : ℝ) :
    ((1-p) • (1 : Matrix n n ℝ) - p • e.permMatrix ℝ) * transfer e p = (1-2*p) • 1 := by
  simp only [transfer, sub_mul, mul_add, smul_mul_smul_comm, one_mul, mul_one,
    permutation_square e he]
  module

def inverseTransfer (e : Equiv.Perm n) (p : ℝ) : Matrix n n ℝ :=
  (1 / (1-2*p)) • ((1-p) • 1 - p • e.permMatrix ℝ)

lemma left_inverse (e : Equiv.Perm n) (he : Function.Involutive e) (p : ℝ) (hp : p < 1/2) :
    inverseTransfer e p * transfer e p = 1 := by
  have hn : 1-2*p ≠ 0 := by linarith
  rw [inverseTransfer, smul_mul_assoc, inverse_numerator e he, smul_smul]
  have h : (1 / (1-2*p)) * (1-2*p) = 1 := by field_simp
  rw [h, one_smul]

theorem injective (e : Equiv.Perm n) (he : Function.Involutive e) (p : ℝ) (hp : p < 1/2) :
    Function.Injective (fun x : n → ℝ => transfer e p *ᵥ x) := by
  have h : Function.LeftInverse (fun x => inverseTransfer e p *ᵥ x)
      (fun x => transfer e p *ᵥ x) := by
    intro x
    change inverseTransfer e p *ᵥ (transfer e p *ᵥ x) = x
    rw [mulVec_mulVec, left_inverse e he p hp, one_mulVec]
  exact h.injective

/-- The existing reconstruction's positivity and operator premises are proved for this family. -/
theorem two_tick_positive (e : Equiv.Perm n) (he : Function.Involutive e) (p : ℝ) (hp : p < 1/2) :
    (transfer e p * transfer e p).PosDef :=
  Reconstruction.two_tick_positive _ (symmetric e he p) (injective e he p hp)

omit [Fintype n] in
/-- Uniform detailed balance holds at every rate; it does not calibrate the rate. -/
theorem constant_balance (e : Equiv.Perm n) (he : Function.Involutive e) (p c : ℝ) (i j : n) :
    c * transfer e p i j = c * transfer e p j i := by
  have h := congrFun (congrFun (symmetric e he p) i) j
  simpa only [transpose_apply] using congrArg (c * ·) h.symm

omit [Fintype n] in
lemma visible_rate (e : Equiv.Perm n) (p : ℝ) (i : n) (hi : e i ≠ i) :
    transfer e p i (e i) = p := by
  simp [transfer, Equiv.Perm.permMatrix, PEquiv.toMatrix_apply, Ne.symm hi]

omit [Fintype n] in
theorem rates_distinct (e : Equiv.Perm n) (i : n) (hi : e i ≠ i) (p q : ℝ) (hpq : p ≠ q) :
    transfer e p ≠ transfer e q := by
  intro h
  have hh := congrFun (congrFun h i) (e i)
  rw [visible_rate e p i hi, visible_rate e q i hi] at hh
  exact hpq hh

/-- Actual Paper I roots instantiate every property without selecting p. -/
theorem actual_root_transfer (c : Fin 3) (p : ℝ) (hp : 0 < p) (hp1 : p < 1/2) :
    (∀ i j, 0 ≤ transfer (CarrierEvents.reflect c) p i j) ∧
    (∀ i, ∑ j, transfer (CarrierEvents.reflect c) p i j = 1) ∧
    (transfer (CarrierEvents.reflect c) p).IsSymm ∧
    (transfer (CarrierEvents.reflect c) p * transfer (CarrierEvents.reflect c) p).PosDef := by
  exact ⟨nonnegative _ _ hp.le (by linarith), stochastic _ _,
    symmetric _ (CarrierEvents.reflection_involutive c) _,
    two_tick_positive _ (CarrierEvents.reflection_involutive c) _ hp1⟩

end PMAction.RootTransfer
